rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ЗАМЕНИ на почту, с которой входишь в admin.html
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ТВОЯ_ПОЧТА@example.com";
    }

    // Её ответы: отправить может кто угодно с сайта, читать и удалять только ты.
    match /answers/{id} {
      allow create: if request.resource.data.keys().hasOnly(["stage", "data", "createdAt"])
                    && request.resource.data.stage is string
                    && request.resource.data.stage.size() < 40
                    && request.resource.data.data is map
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Какие этапы открыты: читают все, меняешь только ты.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
